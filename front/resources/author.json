{
    "fields": [
        {
            "id": "first_name",
            "type": "textfield",
            "label": "Nombre",
            "sort": true,
            "views": ["list", "show", "edit", "create"]
        },
        {
            "id": "last_name",
            "type": "textfield",
            "label": "Apellidos",
            "sort": true,
            "views": ["list", "show", "edit", "create"]
        },
        {
            "id": "books",
            "type": "arrayfield",
            "reference": "book",
            "label": "Libros",
            "field":"title",
            "sort": true,
            "views": ["list", "show", "edit", "create"]
        }
    ],
    "filters": [
        {
            "id":"first_name",
            "label":"Name",
            "type":"textfield"
        },
        {
            "id":"last_name",
            "label":"Email",
            "type":"textfield"
        }
    ],
    "views": {
        "list": {
            "type": "datagrid",
            "options": {
                "rowClick": "show"
            },
            "meta":{
                "with":["books"]
            }
        },
        "show": {
            "type": "simple",
            "meta":{
                "with":["books"]
            }
        },
        "create": {
            "type": "simple"
        },
        "edit": {
            "type": "simple",
            "meta":{
                "with":["books"]
            }
        }
    }
}
