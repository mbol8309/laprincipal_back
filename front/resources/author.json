{
    "fields": [
        {
            "id": "first_name",
            "type": "textfield",
            "label": "Nombre",
            "sort": true,
            "views": ["list", "show", "edit", "create"]
        },
        {
            "id": "last_name",
            "type": "textfield",
            "label": "Apellidos",
            "sort": true,
            "views": ["list", "show", "edit", "create"]
        },
        {
            "id": "image",
            "type": "filefield",
            "label": "Image",
            "sort": true,
            "count":2,
            "views": ["list", "show", "edit", "create"]
        },
        {
            "id": "books",
            "type": "arrayfield",
            "reference": "book",
            "label": "Libros",
            "field": "title",
            "sort": true,
            "views": ["list", "show", "edit", "create"]
        }
    ],
    "filters": [
        {
            "id": "first_name",
            "label": "Name",
            "type": "textfield"
        },
        {
            "id": "last_name",
            "label": "Email",
            "type": "textfield"
        }
    ],
    "views": {
        "list": {
            "type": "datagrid",
            "options": {
                "rowClick": "show"
            },
            "meta": {
                "with": ["books"]
            },
            "actions": {
                "global": [
                ],
                "local":[
                    {
                        "id":"sync_author",
                        "title": "Sync",
                        "dialogTitle": "Sync '${record.first_name}' Author",
                        "component": "LocalActionEndpoint",
                        "icon": "SyncAlt",
                        "color": "secondary",
                        "endpoint":"syncAuthor"
                    },
                    {
                        "id":"add_note_author",
                        "title": "Add Notes",
                        "dialogTitle": "Add note to '${record.first_name}'",
                        "component": "LocalActionFormEndpoint",
                        "icon": "Note",
                        "color": "secondary",
                        "endpoint":"syncAuthor",
                        "fields": [
                            {
                                "id": "note_title",
                                "type": "textfield",
                                "label": "Titulo"
                            },
                            {
                                "id": "note_body",
                                "type": "richtextfield",
                                "label": "Cuerpo"
                            }
                        ]
                    }
                ]
            }
        },
        "show": {
            "type": "simple",
            "meta": {
                "with": ["books"]
            }
        },
        "create": {
            "type": "simple"
        },
        "edit": {
            "type": "simple",
            "meta": {
                "with": ["books"]
            }
        },
        "delete": {}
    }
}
