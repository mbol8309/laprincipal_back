{
    "fields": [
        {
            "id":"name",
            "type":"textfield",
            "label":"Nombre",
            "sort":true,
            "views": ["list", "show", "edit", "create"]
        },
        {
            "id":"permissions",
            "type":"arrayfield",
            "label":"Permissions",
            "reference": "permission",
            "field":"name",
            "sort":true,
            "views": ["list", "show", "edit", "create"]
        }
    ],
    "filters": [
        {
            "id":"first_name",
            "label":"Name",
            "type":"textfield"
        },
        {
            "id":"last_name",
            "label":"Email",
            "type":"textfield"
        }
    ],
    "views": {
        "list": {
            "type": "datagrid",
            "options": {
                "rowClick": "show"
            },
            "meta":{
                "with":[
                    "permissions"
                ]
            }
        },
        "show": {
            "type": "simple",
            "meta":{
                "with":[
                    "permissions"
                ]
            }
        },
        "create": {
            "type": "simple"
        },
        "edit": {
            "type": "simple",
            "meta":{
                "with":[
                    "permissions"
                ]
            }
        }
    }
}
